<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_shipping">
            <field name="name">Gestion de Envios</field>
            <field name="description">Control de acceso para Logistica</field>
            <field name="sequence">10</field>
        </record>

        <!-- Odoo 19: categoria -> privilegio -> grupos -->
        <record id="shipping_privilege_access" model="res.groups.privilege">
            <field name="name">Acceso a Gestion de Envios</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_shipping"/>
        </record>

        <!-- Rol Trafico: Solo lineas -->
        <record id="group_shipping_traffic" model="res.groups">
            <field name="name">Trafico</field>
            <field name="privilege_id" ref="shipping_privilege_access"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rol Administrador: Control total -->
        <record id="group_shipping_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="privilege_id" ref="shipping_privilege_access"/>
            <field name="implied_ids" eval="[(4, ref('group_shipping_traffic'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
